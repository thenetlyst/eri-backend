# -------------------------
# Production Database
# -------------------------
DATABASE_URL=postgresql://exam_user:exam_password@pgbouncer:5432/exam_platform

# -------------------------
# Security
# -------------------------
RANKING_ADMIN_KEY=<generate-a-long-random-secret>

# -------------------------
# Environment
# -------------------------
ENVIRONMENT=production

# -------------------------
# Firebase
# -------------------------
FIREBASE_SERVICE_ACCOUNT=/app/firebase_service_account.json

# -------------------------
# CORS
# -------------------------
CORS_ORIGINS=https://ccl.netlyst.org,https://admin.netlyst.org

# -------------------------
# Worker
# -------------------------
AUTO_FINALIZE_ENABLED=false

# -------------------------
# Profiling
# -------------------------
ENABLE_PROFILING=true

#Complete request profiling, to be used only during load testing:

ENABLE_REQUEST_PROFILING=true